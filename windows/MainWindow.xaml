<Window x:Class="OkinawaCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="沖縄ビジネスITフェス受付カウンター"
        Width="980" Height="780" MinWidth="740" MinHeight="720"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        UseLayoutRounding="True" Language="ja-JP">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="24,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FBBF24" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#072B57" Offset="0" />
                <GradientStop Color="#086F87" Offset="0.52" />
                <GradientStop Color="#12B89A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse Width="600" Height="600" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-340,-220,0" Fill="#0CFFFFFF" IsHitTestVisible="False" />
        <Ellipse Width="720" Height="360" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-220,0,0,-230" Stroke="#18FFFFFF" StrokeThickness="2" IsHitTestVisible="False" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600" Margin="24">
            <TextBlock Text="OKINAWA BUSINESS IT FES" FontSize="12" FontWeight="SemiBold"
                       Foreground="#A7EEE2" HorizontalAlignment="Center" Margin="0,0,0,10" />
            <TextBlock Text="沖縄ビジネスITフェス受付カウンター" FontSize="25" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,26" />
            <Border Background="White" CornerRadius="28" Padding="42,30">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="38" ShadowDepth="12" Opacity="0.22" Color="#001D38" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="ようこそ、沖縄ビジネスITフェスへ" FontSize="14"
                               Foreground="#64748B" HorizontalAlignment="Center" />
                    <TextBlock Text="現在の来場者数" FontSize="16" FontWeight="SemiBold"
                               Foreground="#334155" HorizontalAlignment="Center" Margin="0,24,0,0" />
                    <Viewbox Height="124" Stretch="Uniform" Margin="0,4,0,12">
                        <TextBlock x:Name="CountLabel" Text="{Binding CountText}" FontSize="96"
                                   FontWeight="Bold" Foreground="#0B3454" RenderTransformOrigin="0.5,0.5"
                                   AutomationProperties.AutomationId="VisitorCount" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="CountScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Viewbox>
                    <Border Background="#F1F8F7" CornerRadius="16" Padding="22,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="定員50席" Foreground="#475569" FontSize="15" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PercentageText}" Foreground="{Binding StatusColor}"
                                               FontSize="22" FontWeight="Bold" AutomationProperties.AutomationId="Percentage" />
                                    <TextBlock Text="定員オーバー" Foreground="#DC2626" FontSize="14" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Visibility="{Binding IsOverCapacity, Converter={StaticResource BooleanVisibility}}" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="50" Height="12"
                                         Foreground="{Binding StatusColor}" Background="#DCEBE7" BorderThickness="0"
                                         AutomationProperties.Name="定員50席に対する来場者数" />
                        </StackPanel>
                    </Border>
                    <Button Content="来場者+1" Click="Increment_Click" IsEnabled="{Binding CanIncrement}"
                            Style="{StaticResource RoundedButton}" Background="#087FAD" Foreground="White"
                            BorderBrush="#087FAD" BorderThickness="2" FontSize="22" Margin="0,26,0,12"
                            AutomationProperties.AutomationId="IncrementButton" />
                    <Button Content="リセット" Click="Reset_Click" Style="{StaticResource RoundedButton}"
                            Background="White" Foreground="#526579" BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="24,10" AutomationProperties.AutomationId="ResetButton" />
                </StackPanel>
            </Border>
            <TextBlock Text="海のようにつながる、新しい出会いを。" FontSize="13"
                       Foreground="#C3F2EC" HorizontalAlignment="Center" Margin="0,22,0,0" />
        </StackPanel>
    </Grid>
</Window>
