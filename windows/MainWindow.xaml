<Window x:Class="OkinawaCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="沖縄ビジネスITフェス受付カウンター"
        Width="820" Height="740" MinWidth="640" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Yu Gothic UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="24,14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#122F4C" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#082A55" Offset="0" />
                <GradientStop Color="#076D88" Offset="0.5" />
                <GradientStop Color="#19B99C" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel VerticalAlignment="Center" Margin="36,24">
            <TextBlock Text="沖縄ビジネスITフェス受付カウンター" Foreground="White"
                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,22" />
            <Border Background="White" CornerRadius="28" Padding="40,28" MaxWidth="580">
                <Border.Effect>
                    <DropShadowEffect Color="#031B37" BlurRadius="32" ShadowDepth="10" Opacity="0.26" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="ようこそ、沖縄ビジネスITフェスへ" FontSize="16"
                               Foreground="#4B6477" HorizontalAlignment="Center" />
                    <TextBlock Text="来場者数" FontSize="16" Foreground="#4B6477"
                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                    <Viewbox Height="114" StretchDirection="DownOnly" Margin="0,6,0,8">
                        <TextBlock x:Name="VisitorCount" Text="0人" FontSize="88" FontWeight="Bold"
                                   Foreground="#102D4F" RenderTransformOrigin="0.5,0.5"
                                   AutomationProperties.AutomationId="VisitorCount">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="CountScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Viewbox>
                    <Grid Margin="0,12,0,12">
                        <TextBlock Text="定員50席" Foreground="#4B6477" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="Percentage" Text="0%" FontSize="24" FontWeight="Bold"
                                       Foreground="#16804A" AutomationProperties.AutomationId="Percentage" />
                            <TextBlock x:Name="OverCapacity" Text="定員オーバー" Foreground="#C52D38"
                                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                       Margin="12,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="CapacityProgress" Minimum="0" Maximum="100" Height="14"
                                 Foreground="#16804A" Background="#E7EEF1" BorderThickness="0"
                                 AutomationProperties.Name="定員50席に対する割合">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}" CornerRadius="7" />
                                    <Border x:Name="PART_Track" />
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}" CornerRadius="7" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <Button Content="来場者+1" Click="Increment_Click" Margin="0,30,0,12" Height="64"
                            Background="#087E91" Foreground="White" BorderThickness="0" FontSize="22"
                            AutomationProperties.AutomationId="IncrementButton" />
                    <Button Content="リセット" Click="Reset_Click" Background="White" Foreground="#4B6477"
                            BorderBrush="#B8C9D1" BorderThickness="1" Height="50"
                            AutomationProperties.AutomationId="ResetButton" />
                </StackPanel>
            </Border>
            <TextBlock Text="OKINAWA BUSINESS IT FES" Foreground="#CFEEEF" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,20,0,0" />
        </StackPanel>
    </Grid>
</Window>
